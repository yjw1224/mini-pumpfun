# RainbowKit requires a WalletConnect Cloud project id (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Anvil RPC URL. In Codespaces, use the forwarded URL for port 8545.
NEXT_PUBLIC_ANVIL_RPC_URL=

# Filled in after local deployment
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FAKE_USDC_ADDRESS=
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
